# ===========================================
# Server Configuration
# ===========================================
PORT=5178
NODE_ENV=development

# ===========================================
# Database Configuration
# ===========================================
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=international_trade_crm
DB_SYNCHRONIZE=false
DB_LOGGING=true

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-random-secret
JWT_EXPIRES_IN=7d
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:9527
PUBLIC_BASE_URL=http://localhost:5178

# approval: 注册后由管理员审核；open: 直接启用；disabled: 关闭在线注册
REGISTRATION_MODE=approval
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ===========================================
# DeepSeek AI API (optional)
# ===========================================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
