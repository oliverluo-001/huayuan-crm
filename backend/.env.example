# ===========================================
# Server Configuration
# ===========================================
PORT=5178
NODE_ENV=development

# ===========================================
# Database Configuration
# ===========================================
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=international_trade_crm
DB_SYNCHRONIZE=false
DB_LOGGING=true

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-random-secret
JWT_EXPIRES_IN=7d
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:9527
PUBLIC_BASE_URL=http://localhost:5178
BACKUP_DIR=./data/backups
CUSTOMER_ATTACHMENT_DIR=./data/customer-attachments
PRODUCT_ASSET_DIR=./data/product-assets

# approval: 注册后由超级管理员审核；disabled: 关闭在线注册（旧 open 值也会强制按 approval 处理）
REGISTRATION_MODE=approval
# 唯一超级管理员；生产环境请通过部署密钥注入，不要把真实密码提交到代码仓库
INITIAL_ADMIN_USERNAME=huayuan_owner
INITIAL_ADMIN_PASSWORD=replace-with-a-random-password-at-least-16-characters
INITIAL_ADMIN_DISPLAY_NAME=超级管理员
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ===========================================
# DeepSeek AI API (optional)
# ===========================================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
