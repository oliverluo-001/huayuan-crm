# 本地服务端口
PORT=5178

# 正规搜索 API（均为可选，可同时配置；密钥只保存在本机 .env）。
# 推荐后续申请 Brave Search API；没有密钥时 Agent 会使用公开搜索降级模式，但数量和稳定性较差。
SERPER_API_KEY=
SERPER_API_URL=https://google.serper.dev/search
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search
SERPAPI_API_KEY=
SERPAPI_API_URL=https://serpapi.com/search.json

# 官网没有公开邮箱时，可选用 Hunter 按企业域名补全公开邮箱。
HUNTER_API_KEY=
HUNTER_API_URL=https://api.hunter.io/v2/domain-search

# 单次 Agent 运行允许消耗的搜索请求数。达到预算后会保存游标，可从当前位置继续。
LEAD_AGENT_SEARCH_BUDGET=36

# 点击开始后自动连续执行的最大轮数。任务达到目标、取消或搜索路径真正耗尽时会提前停止。
LEAD_AGENT_AUTO_ROUNDS=12

# 旧版单搜索接口配置，保留向后兼容。
SEARCH_PROVIDER=generic-json
SEARCH_API_URL=
SEARCH_API_KEY=

# generic-json 适配器字段映射，按你的接口返回结构调整。
SEARCH_RESULTS_PATH=items
SEARCH_COMPANY_FIELD=company
SEARCH_BUSINESS_FIELD=business
SEARCH_CONTACT_FIELD=contact
SEARCH_EMAIL_FIELD=email
SEARCH_PHONE_FIELD=phone
SEARCH_WEBSITE_FIELD=website

# 默认 SMTP，可在界面中覆盖。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
